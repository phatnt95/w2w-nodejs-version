# Server
PORT=3002
NODE_ENV=production

# Database (local MongoDB)
MONGO_URI=mongodb://localhost:27017
MONGO_DBNAME=fashiondb

# JWT Authentication
JWT_SECRET=devSecretKey
JWT_EXPIRE=30d

# File Uploads
FILE_UPLOAD_PATH=./public/uploads
MAX_FILE_UPLOAD=2000000

# CORS
CLIENT_URL=http://localhost:3000
